# SIGNBRIDGE Configuration & External AI Provider Settings
# NEVER commit real API keys or secrets to version control.

# Local vs External Provider Selection
# Options: local (default, zero latency, privacy-first) | nvidia_nim | triton
AI_PROVIDER=local

# Optional External Inference Gateway (e.g. NVIDIA NIM / Triton)
AI_API_KEY=
AI_MODEL=meta/llama-3.2-11b-vision-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_INFERENCE_ENABLED=false
AI_TIMEOUT_MS=2000

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SIGNBRIDGE Configuration & External AI Provider Settings
# NEVER commit real API keys or secrets to version control.

# Authoritative Inference Engine (Local 94-D CoordinateMLP)
# Options: local (authoritative default, sub-2ms latency, privacy-first) | nvidia_nim (disabled by default)
AI_PROVIDER=local
AI_INFERENCE_ENABLED=false

# Optional External Inference Gateway (Triton / NIM 94-D Tensor Endpoint)
# NOTE: SIGNBRIDGE is 100% functional without external credentials.
# Incompatible foundation LLM / chat endpoints are automatically blocked and routed to local inference.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=2000

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
